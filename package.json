{
  "name": "@inofix/prisma-generator-nestjs-dto",
  "description": "Generates DTO and Entity classes from Prisma Schema for NestJS",
  "version": "2.2.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Benjamin Kroeger",
    "email": "bk@vegardit.com",
    "url": "https://vegardit.com/"
  },
  "contributors": [
    {
      "name": "Brakebein",
      "url": "https://github.com/Brakebein"
    }
  ],
  "main": "dist/index.js",
  "keywords": [
    "prisma",
    "generator",
    "nestjs",
    "dto",
    "typescript",
    "swagger",
    "openapi"
  ],
  "scripts": {
    "prebuild": "npm run cleanup:generated",
    "build": "tsc --project tsconfig.build.json",
    "format": "prettier --write \"{src,test}/**/*.{js,ts}\"",
    "prelint": "npm run format -- --loglevel error",
    "lint": "eslint \"{src,test}/**/*.{js,ts}\" --fix",
    "pretest": "npm run lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "cleanup:generated": "rimraf src/@generated",
    "pregenerate": "npm run cleanup:generated",
    "generate": "npx prisma generate",
    "generate:mongo": "npx prisma generate --schema ./prisma/mongodb.prisma",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Brakebein/prisma-generator-nestjs-dto"
  },
  "bin": {
    "prisma-generator-nestjs-dto": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "prisma": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "prisma": {
      "optional": true
    }
  },
  "dependencies": {
    "@prisma/generator-helper": "^7.10.0",
    "case": "^1.6.3",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "prettier": "^3.0.0",
    "slash": "^3.0.0"
  },
  "devDependencies": {
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^7.10.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prisma": "^7.10.0",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "deepmerge-ts": ">=8.0.0",
    "file-type": ">=21.3.2",
    "hono": "^4.11.7",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.22",
    "minimatch": ">=10.2.1",
    "mysql2": "^3.24.4"
  }
}
